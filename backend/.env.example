# ===========================================================================
#  EliteMinus backend configuration
#  Copy to ".env" (same folder) and fill in.  Never commit the real .env.
# ===========================================================================

# --- Security --------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database --------------------------------------------------------------
# LOCAL (XAMPP / MariaDB):
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spotify_clone

# ON PYTHONANYWHERE — copy these from the "Databases" tab:
#   DB_USER=yourusername
#   DB_PASSWORD=the-password-you-set-there
#   DB_HOST=yourusername.mysql.pythonanywhere-services.com
#   DB_PORT=3306
#   DB_NAME=yourusername$eliteminus

# --- Front-end (Vercel) ----------------------------------------------------
# Origins allowed to call the API. Comma-separated, no trailing slash.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Where the API sends people who aren't admins.
FRONTEND_URL=https://your-app.vercel.app
# Set to true once the site is served over HTTPS (it is on PythonAnywhere).
SESSION_COOKIE_SECURE=false

# --- SMTP (the OTP e-mails) ------------------------------------------------
# Gmail needs an APP PASSWORD, not your normal password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=EliteMinus
# Leave SMTP_USER empty (or set this to true) and codes print to the console
# instead of being e-mailed — handy for offline development.
MAIL_SUPPRESS_SEND=false

# --- OTP policy ------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# New accounts stay "pending" until an admin approves them.
REQUIRE_ADMIN_APPROVAL=false

# --- "Forgot password? Contact the developer" ------------------------------
DEVELOPER_NAME=Your Name
DEVELOPER_EMAIL=you@gmail.com
DEVELOPER_PHONE=+63 900 000 0000

# --- Spotify ---------------------------------------------------------------
# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be listed EXACTLY as a Redirect URI in the Spotify dashboard.
#   local:      http://localhost:5000/api/spotify/callback
#   production: https://yourusername.pythonanywhere.com/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/spotify/callback
# Two-letter country code used for track availability.
SPOTIFY_MARKET=PH
